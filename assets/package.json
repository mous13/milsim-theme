{
    "name": "@citadel/milsim-theme",
    "description": "Frontend assets for the milsim theme",
    "version": "1.0.0",
    "private": true,
    "devDependencies": {
        "sass": "^1.90.0"
    },
    "scripts": {
        "build": "sass src/styles/index.scss ../public/framework.css --no-source-map --style=expanded",
        "watch": "sass --watch src/styles/index.scss ../public/framework.css --no-source-map --style=expanded"
    }
}
